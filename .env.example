# Desarrollo local. Cloud usa variables del proceso y nunca completa desde .env.
APP_ENV=local
CORS_ORIGINS=["http://localhost:5173"]
# HU-004: URL estable del frontend para el QR; opcional, sin relación con auth.
# Sin configurar, GET /api/menu/config devuelve {"menu_url":null}.
# PUBLIC_MENU_URL=http://localhost:5173/
# Opcional para servir el menú; obligatorio para operar Loyverse manualmente.
LOYVERSE_ACCESS_TOKEN=
# ID comprobado mediante GET /stores. Obligatorio si hay varias tiendas activas
# y siempre al habilitar SYNC_WORKER_URL; debe coincidir con la tienda del worker.
LOYVERSE_STORE_ID=
DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@localhost:5432/mitbol_dev
# Sólo cloud: destino autorizado independiente de la URL; no usar mitbol_dev/test.
# EXPECTED_DATABASE=mitbol_cloud_dev
# EXPECTED_DATABASE_HOST=ep-ejemplo.region.aws.neon.tech
# Cloud exige ?sslmode=verify-full&channel_binding=require en DATABASE_URL.
# CA: certifi incluido; sslrootcert=/ruta/ca.pem permite una CA explícita.

# Administración temporal: exclusivamente backend local, sin integración con React.
ADMIN_ENABLED=false
# Se configura sólo para uso local; generar con secrets.token_urlsafe(32).
ADMIN_API_KEY=
IMAGE_STORAGE_ROOT=storage/product-images

# Sesiones de cuentas: desactivadas por defecto. React -> Render: ver README.
AUTH_ENABLED=false
AUTH_PROFILE=restaurant
AUTH_CATALOG_ENABLED=false
AUTH_IMAGES_ENABLED=false
# HU-010, opcional en el backend: delegación al proceso operativo loopback.
# Ambos ausentes mantienen POST /api/admin/sync/requests deshabilitado (503).
# SYNC_WORKER_URL=http://127.0.0.1:8766
# SYNC_WORKER_TOKEN=<secreto-de-delegacion-independiente>
# SYNC_WORKER_TIMEOUT_SECONDS=120
# Delegación: DATABASE_URL y AUTH_DATABASE_URL explícita deben apuntar al mismo
# host/puerto/base; usuarios distintos por rol. El worker debe usar ese destino
# y el mismo APP_ENV/LOYVERSE_STORE_ID. Ver docs/deployment/hu010_worker.md.
# SYNC_DATABASE_URL y LOYVERSE_ACCESS_TOKEN pertenecen al proceso worker,
# no al Web Service público. El worker no carga este .env; ver docs/deployment/hu010_worker.md.
# Perfil Render futuro (no copiar a Render sin autorización):
# AUTH_DATABASE_URL=<secreto writer, mismo destino autorizado, verify-full/channel_binding=require>
# AUTH_PROXY_MODE=render
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_PARTITIONED=true
# AUTH_PUBLIC_ORIGIN=https://mitbol-backend.onrender.com
# AUTH_ORIGINS=["https://mitbol-frontend.onrender.com"]
# AUTH_LIMIT_BACKEND=postgresql
# AUTH_LIMIT_SECRET=<secreto estable canónico de 32 bytes, URL-safe>
# React localhost -> Render/Neon académicos actuales: AUTH_PROFILE=frontend_dev.
# AUTH_ORIGINS=["http://localhost:5173"]; requiere RENDER_EXTERNAL_URL igual a AUTH_PUBLIC_ORIGIN.
# Procedimiento y variables: docs/security/frontend_remote_dev.md. Activar sólo tras autorización.
