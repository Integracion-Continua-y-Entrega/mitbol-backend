# Desarrollo local. Cloud usa variables del proceso y nunca completa desde .env.
APP_ENV=local
CORS_ORIGINS=["http://localhost:5173"]
# Opcional para servir el menú; obligatorio para operar Loyverse manualmente.
LOYVERSE_ACCESS_TOKEN=
# ID comprobado mediante GET /stores. Obligatorio si hay varias tiendas activas.
LOYVERSE_STORE_ID=
DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@localhost:5432/mitbol_dev
# Sólo cloud: destino autorizado independiente de la URL; no usar mitbol_dev/test.
# EXPECTED_DATABASE=mitbol_cloud_dev
# EXPECTED_DATABASE_HOST=ep-ejemplo.region.aws.neon.tech
# Cloud exige ?sslmode=verify-full&channel_binding=require en DATABASE_URL.
# CA: certifi incluido; sslrootcert=/ruta/ca.pem permite una CA explícita.

# Administración temporal: exclusivamente backend local, sin integración con React.
ADMIN_ENABLED=false
# Se configura sólo para uso local; generar con secrets.token_urlsafe(32).
ADMIN_API_KEY=
IMAGE_STORAGE_ROOT=storage/product-images
